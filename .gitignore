# 환경변수
.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# 가상환경
venv/
.venv/
env/

# 데이터 (용량 큼) — 디렉터리 대신 내용물을 무시해야 README 예외가 먹는다
data/*
!data/README.md
*.json
!sample_data/*.json
# 외부 RAG 시뮬레이터의 골든셋(질문+정답+근거) — 코퍼스는 로컬 전용이지만 이 시험지와
# 뽑아둔 로그(tests/fixtures/external_rag/*.jsonl)는 검증 재현에 필요하다.
!tools/external_rag_questions.json
!tools/external_rag_questions_gap.json
# 벤치마크 골든셋 분할(tools/bench_split_golden.py). 실험의 '정의'라 추적한다 — 분할이
# 바뀌면 이전에 측정한 점수와 비교가 끊기는데 리포트만 봐서는 그 사실을 알 수 없다.
# manifest 에 시드와 질문 목록이 들어 있어 파일이 사라져도 분할을 복원할 수 있다.
!bench/golden_*.json
# 벤치마크 #2(RAGChecker) 결함 주입 실험의 시험지. golden_*.json 과 같은 이유로 추적한다
# — 어떤 질문으로 결함을 주입했는지가 실험의 정의고, 이게 없으면 판정을 재현할 수 없다.
!bench/tax_ext_questions.json
!bench/tax_ext_questions_gap.json
# #2 발표 근거 묶음. bench/out/ 은 실행 산출물이라 제외하지만, 이 실험의 로그·채점은
# LLM 생성물이라 다시 뽑으면 값이 달라진다 — 재현이 아니라 보존이 필요한 자산이다.
!bench/ragchecker_evidence/*.json

# 비밀 정보 — *.json 규칙이 바뀌어도 절대 커밋 금지
agents/ingest/tokens.json
eval_probes.json

# 결과물
results/
output/
lib/
uploads/
# 테스트 코퍼스 — 원본 문서·QA셋·실행 산출물 모두 로컬 자산이라 추적하지 않는다
# (data/ 와 같은 취지: 용량이 크고 각자 준비한다). 규약을 적은 README 만 남긴다.
tests/corpus/*
!tests/corpus/README.md

# 리플레이 진단서 산출물 — 실행할 때마다 덮어쓰는 결과물이다. 같은 폴더의
# ext_*.jsonl(재현용 고정 자산)과 성격이 반대라 out/ 만 따로 제외한다.
tests/fixtures/external_rag/out/

# PDF 원본 — 용량이 크고 대개 배포 불가 자료다(테스트 코퍼스 문서 포함)
*.pdf

# IDE
.vscode/
.idea/
*.DS_Store

# Claude Code
CLAUDE.md

# 벡터 DB
qdrant_storage/

# 로그 (Serve API 기동 로그 등)
*.log

# 로컬 작업용 별도 클론(추적 대상 아님)
pr34b/

# 리플레이 진단서 산출물(tools/run_replay_report.py). 입력 로그(*.jsonl)는 추적하지만
# 산출물은 실행할 때마다 새로 만들어지고, 로그 원문(질문·컨텍스트·답변)이 그대로
# 박혀 있어 커밋되면 안 된다.
tests/fixtures/external_rag/out/

# 벤치마크(bench/opensource-comparison) 산출물. 골든셋 분할(golden_*.json)과 manifest 는
# 실험의 '정의'라 추적한다 — 분할이 바뀌면 이전 점수와 비교가 끊기므로 커밋으로 고정해야
# 재현·감사가 된다. 반면 out/ 은 실행 산출물(triad 로그·parquet·AutoRAG trial 폴더)이고
# 로그엔 답변 원문이 그대로 박혀 있어 커밋하지 않는다.
bench/out/
# 예외: #2(RAGChecker) 발표 근거 묶음. bench/out/ 과 *.log 규칙보다 뒤에 둬야 이긴다
# (gitignore 는 마지막 매칭이 이긴다). 이 실험의 로그·채점은 LLM 생성물이라 다시
# 뽑으면 값이 달라진다 — 재현이 아니라 보존이 필요한 자산이라 추적한다.
!bench/ragchecker_evidence/*.log
.venv-autorag/
.venv-ragchecker/
