## .env.example
## 이 파일을 복사해서 .env로 만들고 실제 값 입력
## cp .env.example .env
##
## 규칙: 주석 처리된 값(# VAR=...)이 코드 기본값. 필요한 것만 주석 해제.
## 키가 하나도 없어도 전 파이프라인이 폴백(휴리스틱/추출식)으로 동작한다.

## ── API 키 (여러 Agent 공용) ──────────────────────────────────────
## 주의: OPENAI_API_KEY는 "존재하기만 하면" 두 곳이 OpenAI로 바뀐다(각각 실행당 1회 로그).
##       - Index 그래프 entity 추출(graph_extraction=auto): 청크당 1회 호출.
##         끄려면 config graph_extraction=keyword.
##       - RAG 답변 생성(RAG_LLM_PROVIDER 미설정=auto): OpenAI를 먼저 시도.
##         Gemini로 고정하려면 RAG_LLM_PROVIDER=gemini.
##       자리표시자(sk-...)를 넣어두면 401만 반복되니, 진짜 키가 없으면 아예 비워둘 것.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GITHUB_TOKEN=
## OpenRouter: 키 하나로 여러 publisher 모델(openai/…, anthropic/…, google/… )을 호출.
## 유료이며, 모델명은 반드시 "publisher/model" 형식. 임베딩 엔드포인트는 없다(아래 주의).
# OPENROUTER_API_KEY=

## ── Ingest Agent (수집) ───────────────────────────────────────────
## Notion: 내부 통합 토큰(ntn_/secret_...) 또는 OAuth 앱(CLIENT_ID/SECRET 브라우저 플로우)
# NOTION_TOKEN=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
## tests/test_pipeline.py 가 수집할 Notion 페이지 URL
# TEST_NOTION_URL=

## 파이프라인 소스(run_local_pipeline.py / graph.py 공용) — state.source_type/source_url 로 들어감.
##   미설정 시 기본값은 file(sample_docs/hr_policy.md) — 레포에 포함돼 클론 직후 바로 실행된다.
##   korquad 는 data/corpus.jsonl·data/qa_pairs.jsonl 을 직접 준비해야 한다(data/README.md 참고).
##   SOURCE_TYPE=korquad 이면 Eval 이 자동으로 taxonomy 소스를 쓰도록 세팅되고,
##   corpus 는 SOURCE_URL 하나로 통일 — Ingest(문서 복원)와 Eval(gold 좌표)이 같은 파일을 본다.
# SOURCE_TYPE=file                ## file | korquad | notion | json_corpus
# SOURCE_URL=sample_docs/hr_policy.md
# KORQUAD_MAX_DOCS=      ## (korquad) 앞 N개 문서만(스모크). 0/미설정=전체. corpus·qa 동일 규칙

## ── Index Agent (청킹·임베딩) ─────────────────────────────────────
## HuggingFace 토큰(BGE-M3 다운로드 rate limit 완화용, 선택)
# HF_TOKEN=hf_...
## 지식그래프 산출물은 기본으로 꺼져 있다(index_config["graph_enabled"]=False).
## 시각화·구조 확인용이라 검색 품질과 무관한데, 켜면 entity 추출이 청크마다 LLM 을
## 1회씩 불러 코퍼스가 크면 가장 비싼 단계가 되기 때문. 필요하면 코드/설정에서
## graph_enabled=True 로 명시적으로 켤 것.
##
## 켰을 때 쓸 provider. auto 는 OPENAI_API_KEY 만 본다 — OpenRouter 는 여기에
## openrouter 를 명시해야 켜진다(Eval/RAG 용 키가 이 단계까지 켜지 않도록).
## LLM 없이 산출물만 원하면 graph_extraction=keyword (호출 0회).
## (청크 임베딩은 로컬 BGE-M3라 이 설정과 무관하다)
# INDEX_LLM_PROVIDER=auto          ## auto | openai | openrouter
## OpenRouter 로 갈 때 쓸 모델. index_config["graph_llm_model"](OpenAI용, 기본
## gpt-4.1-mini)은 "publisher/model" 형식이 아니라 그대로 보내면 404가 나므로 분리했다.
# INDEX_GRAPH_MODEL_OPENROUTER=openai/gpt-4.1-mini
## Qdrant — 기본은 프로세스 내 인메모리(:memory:). Index·Eval·RAG·Serve 공용.
# QDRANT_URL=:memory:
# QDRANT_API_KEY=
## ── 색인 임베딩: 어디서 계산할지 ─────────────────────────────────
## openrouter(기본) | local
## 실측(tools/bench_embedding.py, 한국어 1,000청크):
##   로컬 CPU        2 chunks/sec      26MB 코퍼스 = 2.3시간
##   OpenRouter 동시8  371 chunks/sec    26MB 코퍼스 = 0.7분 / $0.06
##
## 기본값이 openrouter 인 이유: 이 프로젝트는 OpenRouter 예산이 확보된 상태로
## 운영한다는 전제다. 그러면 CPU 로 돌릴 이유가 사실상 없다 — 100배 넘는 시간 차이를
## 몇 센트로 사는 셈이라 "예산이 있는데 CPU" 라는 선택지가 실질적으로 없기 때문이다.
## 예산이 없거나 오프라인이면 local 로 내린다.
##
## 두 경로의 벡터는 코사인 0.99997 로 사실상 같고 차원도 1024 로 동일하다 —
## provider 를 바꿔도 컬렉션을 다시 만들 필요가 없다.
## openrouter 는 OPENROUTER_API_KEY 가 필요하고, 없으면 예외로 멈춘다(조용히 로컬로
## 새지 않는다 — "API 로 돌리는 중" 이라 믿은 색인이 2 chunks/sec 가 되는 걸 막는다).
# INDEX_EMBED_PROVIDER=openrouter
##
## 셋을 번갈아 비교할 때는 env 대신 플래그를 쓸 것. 엔트리포인트가
## load_dotenv(override=True) 라 셸 값보다 .env 가 이기므로,
## INDEX_EMBED_PROVIDER=local python graph.py 는 조용히 무시된다.
##   python graph.py --embed openrouter | gpu | cpu
##   python run_local_pipeline.py --embed gpu
##   python -m tests.run_corpus --embed cpu
## 질의(검색) 임베딩. 색인과 별개 축이지만 기본값은 같은 openrouter 다.
## 축을 나눈 값어치는 "질의만 내릴 수 있다" 는 데 있다 — 색인은 대량·일회성이라
## 재시도가 남는 장사지만, 질의는 단건·대화형이라 재시도가 그대로 사용자 지연이 된다.
## 실측 429 가 19% 라 단건 질의가 재시도에 걸리면 /search 한 건이 수십 초 블로킹될 수
## 있고, 그때 이 값만 local 로 내리면 된다. 로컬/OpenRouter bge-m3 벡터는 코사인
## 0.99997 이라 색인을 API 로 질의를 로컬로 계산해도 순위가 흔들리지 않는다.
##
## openrouter 로 두고 OPENROUTER_API_KEY 가 없으면 retriever 진입 시 예외로 끊는다 —
## 그냥 두면 모든 질의가 keyword 검색으로 조용히 떨어져 원인 추적이 불가능하다.
# INDEX_QUERY_EMBED_PROVIDER=openrouter
## OpenRouter 쪽 모델 철자. 로컬은 "BAAI/bge-m3", OpenRouter 는 소문자다.
# INDEX_EMBED_MODEL_OPENROUTER=baai/bge-m3
## API 요청당 텍스트 수와 동시 요청 수. 실측에서 동시 8이 가성비 지점이었다
## (16은 6% 빠른 대신 429가 3배). 429는 동시성과 무관하게 상시 섞여 나오므로
## 동시성을 낮추는 게 아니라 재시도(EVAL_LLM_MAX_RETRIES)로 흡수한다.
# INDEX_EMBED_API_BATCH=64
# INDEX_EMBED_CONCURRENCY=8
## local 일 때 쓸 장치. auto 는 CUDA 가 있으면 cuda, 없으면 cpu.
## cuda 를 명시했는데 못 쓰면 경고하고 cpu 로 내린다(조용히 내리지 않는다).
# INDEX_EMBED_DEVICE=auto
## local 일 때 청크 임베딩 배치 크기. 1이면 단건 인코딩 루프(기존 동작과 bit-identical).
## >1 은 근사 — 배치 패딩/누적 순서로 벡터에 ~1e-7 수준 미세차 가능(검색 품질엔 무시 수준).
## CUDA OOM 이 나면 이 값을 절반씩 줄여 재시도하고, 그래도 안 되면 CPU 로 옮긴다.
# INDEX_EMBED_BATCH=32
## 임베딩 모델 로드 실패 후 재시도까지의 쿨다운(초). 실패 시 해시 기반 fallback
## 임베딩(의미 검색 불가)이 쓰이므로, 일시적 실패(네트워크 등)에서 복구되도록 재시도한다.
# INDEX_EMBED_MODEL_RETRY_SEC=300
## reranker(use_reranker=True) 모델 로드 실패 후 재시도까지의 쿨다운(초). 위와 동일 정책 —
## 일시적 실패 후에도 프로세스 내내 리랭킹이 죽지 않도록 쿨다운이 지나면 재시도한다.
# INDEX_RERANKER_RETRY_SEC=300

## ── Eval Agent (진단) ─────────────────────────────────────────────
## 아래는 전부 선택(주석 처리된 값이 코드 기본값). 기본값만으로도 외부 API 없이 폴백 동작.

## Probe 소스: auto | user_log | made | taxonomy (미지정=자동 판별)
##   auto     = 지식그래프 기반 자동 생성(user_questions 무시). GT·gold 포함 → recall/F1/RAGAS 전량 평가.
##   user_log = 실사용 질문(user_questions) 사용. GT 없음 → reference-free RAGAS만.
##   made     = eval_probes.json 을 코퍼스 버전과 무관하게 고정 테스트셋으로 재사용
##              (임계값 캘리브레이션 등 실행 간 비교가 필요할 때 권장. LLM 비용도 0).
##   taxonomy = 외부 사람작성 QA 데이터셋(KorQuAD 등). qa=EVAL_TAXONOMY_QA, corpus=SOURCE_URL(위) 재사용.
##   미지정   = user_questions 있으면 user_log, 없으면 auto (기존 동작).
## EVAL_PROBE_SOURCE=

## KorQuAD(taxonomy) 세부 — qa 파일과 규모.
# EVAL_TAXONOMY_QA=data/qa_pairs.jsonl
# KORQUAD_QA_LIMIT=      ## qa 개수 상한. 0/미설정=전체

## 자동 생성 QA셋(probe) 개수. 임계값 캘리브레이션 시 30~50 권장
## (n이 작으면 overall 점수가 QA셋 뽑기 운에 크게 출렁임: n=10 → ±16%p, n=30 → ±9%p 수준)
## EVAL_TESTSET_SIZE=30

## 진단 깊이(비용 tier): fast|standard|deep|full 또는 1~4
# EVAL_MODE=fast

## RAGAS(LLM-as-Judge) 진단 허용. 1/true 여야 하며, 실제 실행은 EVAL_MODE>=deep 과 AND.
# EVAL_ENABLE_LLM=0

## LLM provider 선택: openai | gemini | github | openrouter
# EVAL_LLM_PROVIDER=openai

## LLM 모델 (Eval 이 쓰는 건 심판·임베딩뿐. 답변 생성 모델은 아래 RAG_* 항목이 담당하며,
## "응답 모델 != 심판 모델" 원칙은 그 둘 사이에 적용된다. 선택한 provider 파트만 채우기).
## OpenAI
# EVAL_JUDGE_MODEL=gpt-4o
# EVAL_EMBED_MODEL=text-embedding-3-small
## Gemini — 주의: 기본값 gemini-flash-latest 별칭은 서버에서 gemini-2.5-flash 로
## 해석되는데, 신규 발급 키에는 그 모델이 차단돼 404가 남. 신규 키면 아래처럼
## 명시적 최신 모델을 지정할 것 (사용 가능 목록: client.models.list()).
# EVAL_JUDGE_MODEL_GEMINI=gemini-3.5-flash       # probe 생성 + RAGAS 심판 (chat_json 경로)
# EVAL_EMBED_MODEL_GEMINI=gemini-embedding-001   # response_relevancy 임베딩
## GitHub Models
# EVAL_JUDGE_MODEL_GITHUB=openai/gpt-4o
## OpenRouter — 심판 모델은 response_format=json_object 를 지원하는 것으로 고를 것.
## 미지원 모델이면 JSON 파싱이 실패해 조용히 {} 로 폴백한다(점수가 결측 처리됨).
# EVAL_JUDGE_MODEL_OPENROUTER=openai/gpt-4o
## OpenRouter 임베딩(response_relevancy 용). Index 가 쓰는 로컬 모델과 같은 bge-m3 이고
## $0.01/1M 이라 사실상 공짜다. 벡터도 로컬과 코사인 0.99997 로 사실상 동일하다
## (tools/bench_embedding.py 실측).
# EVAL_EMBED_MODEL_OPENROUTER=baai/bge-m3
## 임베딩 우선순위: 활성 provider 의 임베딩 API > 로컬 BGE-M3 > 결측.
## GitHub Models 는 임베딩 엔드포인트가 없어 OPENAI_API_KEY 로 폴백하고, 그 키도 없으면
## 로컬 BGE-M3 로 계산한다 — 비용 0, 외부 호출 없음. 셋 다 불가할 때만 결측이다.
## 결측이면 response_relevancy 뿐 아니라 bad_gold_answer 라벨과 probe 자동 재생성까지 멈춘다.
## 주의: provider 를 바꾸면 임베딩 모델이 바뀌어 코사인 분포가 달라진다. response_relevancy
## 를 실행 간에 비교하려면 한 번 정한 뒤 고정할 것.

## RAGAS Response Relevancy: 답변당 질문 생성 횟수(strictness)
# EVAL_RELEVANCY_STRICTNESS=3

## LLM 호출 동시 실행 수 (STEP1 probe 합성 + STEP2 답변 생성 + STEP3-2 RAGAS probe×track).
## 1이면 완전 순차. 무료 티어처럼 분당 한도(RPM)가 낮으면 2~3 권장 — 429 재시도 로그가
## 잦으면 낮출 것. 유료 티어(RPM 1000급)면 8~16까지 올려도 됨.
# EVAL_LLM_CONCURRENCY=10

## RAGAS 트랙 1개 내부(지표 4개·청크별 판정·strictness 반복) 동시성. 기본 1(=off).
## 실효 동시 요청 = EVAL_LLM_CONCURRENCY × 이 값(곱)이므로 함께 올리면 RPM 한도 주의.
## probe 수가 적어 바깥 병렬이 놀 때(소수 probe 검증)만 2~4 권장.
# EVAL_RAGAS_INNER_CONCURRENCY=1

## LLM rate limit(429) 재시도 — Gemini 무료 티어 등에서 "too many requests" 대응
# EVAL_LLM_RETRY_WAIT=5      # 재시도 전 대기 시간(초, 실제 대기는 ×1~2 jitter)
# EVAL_LLM_MAX_RETRIES=5     # 재시도 횟수 상한(소진하면 폴백)

## 테스트(test_ragas_eval)에서 LLM 입출력 로깅
# EVAL_DEBUG=

## ── LLM 사용량·비용 로깅 (core/llm_usage.py — Eval·RAG 공용) ──────
## 토큰 수와 추정 비용(단가표 × 토큰)을 집계한다.
##   0/false/off : 전부 끔
##   1 (기본)     : STEP 단위 요약 — 각 단계 끝에 호출수·토큰·비용·시간 한 줄
##   verbose      : 위에 더해 LLM 호출 1건마다 토큰 줄 출력(디버깅용, 매우 시끄러움)
# LLM_LOG_USAGE=1

## ── RAG (검색 + 답변 생성 — Eval STEP2 와 Serve /answer 공용) ─────
## provider 선택: auto(기본) | openai | gemini | github | openrouter
##   auto = OpenAI → Gemini → GitHub → OpenRouter 순서로 키가 있는 provider 시도.
##   OpenRouter 를 항상 쓰려면 auto 에 맡기지 말고 openrouter 로 고정할 것.
# RAG_LLM_PROVIDER=auto

## 모든 provider 공통 모델 오버라이드(지정 시 아래 provider별 모델보다 우선, auto 모드 제외).
# RAG_LLM_MODEL=

## 답변 생성 출력 상한. 공용 기본값(2048)은 컨텍스트가 긴 코퍼스에서 부족했다 —
## KorQuAD 위키 문서로 돌린 실행에서 답변이 finish_reason=length 로 잘렸고,
## 잘린 답변이 그대로 채점돼 faithfulness·answer_correctness 가 부당하게 낮아졌다.
## 상한은 실사용분만 과금되니 올려도 정상 답변의 비용은 그대로다.
## 로그에 "응답이 출력 상한에서 잘렸습니다" 가 계속 보이면 더 올릴 것.
# RAG_MAX_OUTPUT_TOKENS=4096

## OpenRouter 추론 토큰. 기본은 끔 — output 으로 과금되는데 심판 비용의 대부분이었다
## (실측: 출력 3,522 → 532 토큰, 비용 55% 절감, 판정 결과는 사실상 동일).
## 애매한 판정에서 점수가 거칠어지면 1 로 되살려 비교할 것.
## 주의: 이 스위치는 OpenRouter 로 나가는 모든 호출(심판·답변 생성)에 걸린다.
## 심판을 OpenRouter 경유 추론 모델(openai/o3, gpt-5 계열)로 잡으면 추론을 쓰라고
## 고른 모델의 추론이 기본으로 꺼진다 — 그 조합에서는 1 로 켤 것.
# OPENROUTER_REASONING=0

## OpenAI (openai SDK — 필요 시 표준 OPENAI_BASE_URL을 SDK가 자동 인식)
# RAG_OPENAI_MODEL=gpt-4o
## Gemini — 위 Eval 의 gemini-flash-latest 주의사항 동일. 신규 키면 명시 지정.
# RAG_GEMINI_MODEL=gemini-3.5-flash
## GitHub Models (토큰: GITHUB_MODELS_TOKEN 우선, 없으면 위 GITHUB_TOKEN.
##  auto 모드에선 전용 토큰(GITHUB_MODELS_TOKEN)이 있을 때만 GitHub 를 시도)
# GITHUB_MODELS_TOKEN=
# RAG_GITHUB_MODEL=openai/gpt-4o
## OpenRouter (키: 위 OPENROUTER_API_KEY). 모델명은 "publisher/model" 형식.
# RAG_OPENROUTER_MODEL=openai/gpt-4o

## ── Serve Agent (API 서버·MCP) ────────────────────────────────────
## FastAPI 서버 포트 (/health /documents /search /answer)
# AGENT_DOCTOR_API_PORT=8766
## API 서버 기동 대기 시간(초). api.py 는 리스닝 전에 청크 로드·retriever 구축을
## 하므로 코퍼스가 크면 늘려야 할 수 있다. 초과 시 Serve 는 error 로 종료.
# AGENT_DOCTOR_API_START_TIMEOUT=30
## MCP stdio 서버(mcp_server.py)가 바라볼 API 주소·청크 파일 (기본값으로 충분)
# AGENT_DOCTOR_API_URL=http://localhost:8766
# AGENT_DOCTOR_CHUNKS_FILE=chunks.json
